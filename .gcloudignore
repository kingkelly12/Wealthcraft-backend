.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (if applicable)
node_modules/
npm-debug.log
yarn-error.log

# OS files
.DS_Store
Thumbs.db

# Local development
instance/
*.db
*.sqlite
.pytest_cache
.venv/

# Docker
.docker/
docker-compose.override.yml

# Environment files (NEVER upload .env)
.env
.env.local
.env.*.local

# Documentation
*.md
docs/
